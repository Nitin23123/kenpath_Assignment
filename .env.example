# Sweety Environment Variables Blueprint

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sweety_db
DB_USER=postgres
DB_PASSWORD=
# Or use connection string:
# DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/sweety_db

# Test Database Configuration
TEST_DB_NAME=sweety_test_db

# Redis Caching (Optional - Graceful fallback if offline)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Or use connection string:
# REDIS_URL=redis://localhost:6379

# Authentication / JWT
JWT_SECRET=sweety_super_secret_jwt_key_development_only_123456
JWT_EXPIRES_IN=7d

# Client Configuration
VITE_API_URL=http://localhost:5000/api
